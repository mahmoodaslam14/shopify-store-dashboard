# Copy this file to .env.local and fill in your own values.
# Never commit real keys.

# Database (matches docker-compose.yml for local dev)
DATABASE_URL=postgresql://dashboard:dashboard_dev_password@localhost:5432/customer_dashboard
# Only needed for `npm run db:setup` (creates the local database with a superuser)
ADMIN_DATABASE_URL=postgresql://postgres:YOUR_SUPERUSER_PASSWORD@localhost:5432/postgres

# Sessions: any random string of 32+ characters
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shopify custom app (Admin API). See docs/SHOPIFY_SCOPES.md for required scopes.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-01

# Cashback: how many points equal 1 unit of shop currency
POINTS_PER_CURRENCY_UNIT=100

# Protects the /api/cron/reconcile endpoint
CRON_SECRET=

# Optional: transactional email via Resend
RESEND_API_KEY=

# Optional: create the first admin with `npm run db:seed`
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
